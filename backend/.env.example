# Application
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database — Supabase connection string
# Transaction pooler (port 6543) para queries normales
DATABASE_URL="postgresql://postgres:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) para migraciones Prisma
DIRECT_URL="postgresql://postgres:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# JWT — mínimo 32 caracteres aleatorios por secreto
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars_here
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
