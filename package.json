{
  "name": "techtransit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:reset": "docker compose down -v && docker compose up -d --wait db",
    "lint": "npm run lint -w backend -w frontend",
    "build": "npm run build -w backend -w frontend",
    "format": "prettier --write \"**/*.{ts,tsx,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
